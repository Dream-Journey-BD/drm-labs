{
  "name": "drm-labs",
  "private": true,
  "version": "1.0.0",
  "description": "DRM Labs - Professional ClearKey DRM Packaging, Multi-Format Video Player, IPTV Playlist Analyzer & DRM Inspector",
  "main": "server.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node dist/server.cjs",
    "setup": "node scripts/download-packager.js",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "clean": "node scripts/clean.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "multer": "^1.4.5-lts.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "shaka-player": "^5.2.8",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "allowScripts": {
    "esbuild": true,
    "esbuild@*": true,
    "esbuild@0.25.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
